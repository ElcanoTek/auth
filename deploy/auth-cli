#!/usr/bin/env bash
# /usr/local/bin/auth — operator entry point for Elcano auth-server.
#
# Thin dispatcher that forwards to:
#   - auth-admin for `auth domain ...` and `auth user ...`
#   - systemctl  for `auth start|stop|restart|status|logs`
#   - scripts/   for `auth update`, `auth env`, `auth backup`
#
# Installed by scripts/bootstrap.sh. This file is source, not the
# final path.

set -euo pipefail

# The install root may be overridden by root (tests, alternate prefixes),
# never by an unprivileged caller: several subcommands exec sudo on paths
# under it.
if [[ $EUID -eq 0 ]]; then
  APP_DIR="${APP_DIR:-/opt/auth}"
  APP_USER="${APP_USER:-auth}"
else
  APP_DIR="/opt/auth"
  APP_USER="auth"
fi
ADMIN_BIN="$APP_DIR/bin/auth-admin"
ENV_LOCAL="$APP_DIR/.env.local"

# run_admin SUBCOMMAND ARGS... runs auth-admin as the service user with the
# settings it needs from .env.local in its environment. Root reads the file
# (it is root:auth 0640) and exports only what the command uses; runuser
# keeps the environment, so no secret ever appears in an argument list, and
# SUDO_USER survives for the "cli:<who>" attribution. The binary and the
# database are touched as the service user, never as root, so the store
# never acquires root-owned files. A non-root caller is re-run under sudo.
# load_env_file FILE exports its KEY=VALUE lines without executing the file:
# it is data, whoever could write it. Quoting follows the server's loader.
load_env_file() {
  local file="$1" line key v
  [[ -f "$file" && ! -L "$file" ]] || return 0
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line#"${line%%[![:space:]]*}"}"
    [[ "$line" =~ ^([A-Za-z_][A-Za-z0-9_]*)[[:space:]]*=(.*)$ ]] || continue
    key="${BASH_REMATCH[1]}"; v="${BASH_REMATCH[2]}"
    # Only the service's own settings: never LD_PRELOAD, PATH, BASH_ENV or
    # anything else a formerly service-writable file could carry.
    case "$key" in AUTH_*|SENDGRID_API_KEY) ;; *) continue ;; esac
    export "$key=$(env_unquote "$v")"
  done < "$file"
}

# env_unquote RAW prints the value of one env-file assignment the way the
# server's loader reads it: surrounding whitespace trimmed; a double-quoted
# value ends at the first unescaped quote and unescapes \" and \; a
# single-quoted value ends at the next quote; a bare value ends at the first
# " #". Shared shape with internal/config's envFileValue.
env_unquote() {
  local v="$1" out="" i c n
  v="${v#"${v%%[![:space:]]*}"}"
  v="${v%"${v##*[![:space:]]}"}"
  case "$v" in
    \"*)
      i=1
      while (( i < ${#v} )); do
        c="${v:i:1}"
        if [[ "$c" == "\\" ]]; then
          n="${v:i+1:1}"
          if [[ "$n" == '"' || "$n" == "\\" ]]; then out+="$n"; (( i += 2 )); continue; fi
          out+="$c"; (( i++ )); continue
        fi
        [[ "$c" == '"' ]] && break
        out+="$c"; (( i++ ))
      done
      printf '%s' "$out" ;;
    \'*) v="${v:1}"; printf '%s' "${v%%\'*}" ;;
    *) v="${v%%#*}"; printf '%s' "${v%"${v##*[![:space:]]}"}" ;;
  esac
}


run_admin() {
  if [[ $EUID -ne 0 ]]; then
    exec sudo -- "$0" "$@"
  fi
  # Script variables are captured first: the allowlist below unsets every
  # exported name, including these when a caller exported them.
  local actor="${SUDO_USER:-}" app_user="$APP_USER" admin_bin="$ADMIN_BIN" app_dir="$APP_DIR" v
  load_env_file "$ENV_LOCAL"
  # The service user gets exactly these variables (runuser keeps the
  # environment, so nothing travels on a command line): the settings
  # auth-admin reads, the operator's name for the audit trail, a minimal
  # PATH and a HOME it can write.
  for v in $(compgen -e); do
    case "$v" in
      AUTH_DATA_DIR|AUTH_MFA_KEY|AUTH_MFA_KEY_ID|AUTH_MFA_PREVIOUS_KEYS|AUTH_SIGNING_KEY|AUTH_BRAND_NAME|AUTH_HOSTNAME|AUTH_ISSUER_URL|AUTH_PASSWORD_BLOCKED_TERMS|AUTH_LOGIN_MODE|TERM|LANG|LC_ALL) ;;
      *) unset "$v" ;;
    esac
  done
  export AUTH_DATA_DIR="${AUTH_DATA_DIR:-$app_dir/data}"
  export SUDO_USER="$actor" PATH=/usr/local/bin:/usr/bin:/bin HOME="$AUTH_DATA_DIR"
  exec runuser -u "$app_user" -- "$admin_bin" "$@"
}

if [[ -t 1 && "${TERM:-}" != "dumb" ]]; then
  c_reset=$'\033[0m' c_dim=$'\033[2m' c_bold=$'\033[1m'
  c_cyan=$'\033[0;36m' c_red=$'\033[0;31m' c_green=$'\033[0;32m' c_yellow=$'\033[0;33m'
else
  c_reset='' c_dim='' c_bold='' c_cyan='' c_red='' c_green='' c_yellow=''
fi

# Loaded only for commands that need it. `auth doctor` runs as root and must
# not source the service tree: that tree is writable by the service user.
load_env_helpers() {
  # shellcheck source=/dev/null
  if [[ -f "$APP_DIR/scripts/lib/envfile.sh" ]]; then
    . "$APP_DIR/scripts/lib/envfile.sh"
  else
    env_show_redacted() {
      awk '
        /^[[:space:]]*#/ { next } /^[[:space:]]*$/ { next }
        { eq = index($0, "="); if (eq == 0) { print; next }
          key = substr($0, 1, eq - 1); sub(/^[[:space:]]+/, "", key)
          if (key ~ /TOKEN|KEY|SECRET|PASS/) printf "%s=[REDACTED]\n", key; else print }
      ' "$1"
    }
  fi
}

# A script root may execute: not a symlink, owned by root, not group/world writable.
script_root_owned() {
  local p="$1" owner mode
  [[ -f "$p" && ! -L "$p" ]] || return 1
  owner="$(stat -c '%U' "$p" 2>/dev/null || echo "")"
  mode="$(stat -c '%a' "$p" 2>/dev/null || echo 666)"
  [[ "$owner" == root && $((8#$mode & 022)) -eq 0 ]]
}

env_cmd() {
  local sub="${1:-show}"
  shift || true
  case "$sub" in
    show|"")        _env_show ;;
    edit)           _env_edit ;;
    check)          _env_check ;;
    -h|--help|help) _env_help ;;
    *) echo "unknown env subcommand: $sub" >&2; _env_help; exit 1 ;;
  esac
}

_env_help() {
  cat <<EOF
auth env — inspect + edit auth environment variables

SUBCOMMANDS
  auth env show   Print $ENV_LOCAL (secrets redacted)
  auth env edit   Open $ENV_LOCAL in nano/vim/helix
                  (offered via dnf install if missing)
  auth env check  Verify $ENV_LOCAL exists, parses cleanly, and is
                  readable by auth-server. Run BEFORE 'auth restart'
                  if a recent edit might have changed perms or syntax.

NOTES
  • $ENV_LOCAL is the per-operator override file (gitignored).
    auth-server re-reads it on restart, so 'auth restart' after editing.
  • See $APP_DIR/.env.local.example for the catalog of supported keys.
EOF
}

_env_show() {
  if [[ -f "$ENV_LOCAL" ]]; then
    printf '%s# %s%s\n' "$c_bold" "$ENV_LOCAL" "$c_reset"
    env_show_redacted "$ENV_LOCAL"
  else
    printf '%s# %s (not present — create one with: sudo auth env edit)%s\n' "$c_dim" "$ENV_LOCAL" "$c_reset"
  fi
}

_env_edit() {
  [[ $EUID -eq 0 ]] || { echo "run as root: sudo auth env edit" >&2; exit 1; }

  local app_user="${APP_USER:-auth}"

  [[ -L "$ENV_LOCAL" ]] && { echo "$ENV_LOCAL is a symlink; refusing to edit through it" >&2; exit 1; }
  if [[ ! -f "$ENV_LOCAL" ]]; then
    install -o root -g "$app_user" -m 0640 /dev/null "$ENV_LOCAL"
  fi

  local -a names=(nano vim helix)
  local -a bins=(nano vim hx)
  local -a pkgs=(nano vim helix)

  echo "Pick an editor for $ENV_LOCAL:"
  local i default=""
  for i in 0 1 2; do
    if command -v "${bins[i]}" >/dev/null 2>&1; then
      printf '  %d) %s\n' "$((i+1))" "${names[i]}"
      [[ -z "$default" ]] && default=$((i+1))
    else
      printf '  %d) %s %s(not installed — will dnf install on select)%s\n' \
        "$((i+1))" "${names[i]}" "$c_dim" "$c_reset"
    fi
  done
  [[ -n "$default" ]] || default=1

  printf '%s?%s Choice [%d]: ' "$c_cyan" "$c_reset" "$default" >&2
  local choice
  read -r choice
  choice="${choice:-$default}"

  local idx
  case "$choice" in
    1|nano)     idx=0 ;;
    2|vim)      idx=1 ;;
    3|helix|hx) idx=2 ;;
    *) echo "invalid choice: $choice" >&2; exit 1 ;;
  esac

  local bin="${bins[idx]}" pkg="${pkgs[idx]}" name="${names[idx]}"
  if ! command -v "$bin" >/dev/null 2>&1; then
    printf '%s?%s %s is not installed. Run %sdnf install -y %s%s now? %s(Y/n)%s ' \
      "$c_cyan" "$c_reset" "$name" "$c_bold" "$pkg" "$c_reset" "$c_dim" "$c_reset" >&2
    local answer; read -r answer
    if [[ "${answer,,}" == "n" || "${answer,,}" == "no" ]]; then
      echo "cancelled" >&2; exit 1
    fi
    dnf install -y "$pkg" >/dev/null || { echo "dnf install $pkg failed" >&2; exit 1; }
    echo "✓ $name installed"
  fi

  "$bin" "$ENV_LOCAL"
  # Root writes, the service reads.
  chown root:"$app_user" "$ENV_LOCAL"
  chmod 0640 "$ENV_LOCAL"
  echo "✓ $ENV_LOCAL saved (run 'sudo auth env check' to validate, then 'sudo auth restart')"
}

_env_check() {
  local app_user="${APP_USER:-auth}"
  local fail=0 warn=0
  load_env_file "$ENV_LOCAL"

  printf '%schecking %s%s\n' "$c_bold" "$ENV_LOCAL" "$c_reset"

  if [[ ! -e "$ENV_LOCAL" ]]; then
    printf '  %s✗%s file does not exist (run %ssudo auth env edit%s)\n' \
      "$c_red" "$c_reset" "$c_bold" "$c_reset"
    return 1
  fi
  if [[ ! -f "$ENV_LOCAL" ]]; then
    printf '  %s✗%s exists but is not a regular file\n' "$c_red" "$c_reset"
    return 1
  fi
  printf '  %s✓%s exists\n' "$c_green" "$c_reset"

  local owner mode
  owner="$(stat -c '%U:%G' "$ENV_LOCAL" 2>/dev/null || echo unknown)"
  mode="$(stat -c '%a' "$ENV_LOCAL" 2>/dev/null || echo "")"
  # Root writes the file and the service reads it: root:auth 0640. A file
  # still owned by the service user is the pre-2026-09 layout; the next
  # `sudo auth rebuild` migrates it.
  if [[ "$owner" == "root:$app_user" ]]; then
    printf '  %s✓%s owned by %s\n' "$c_green" "$c_reset" "$owner"
  elif [[ "$owner" == "$app_user:$app_user" ]]; then
    printf '  %s!%s owned by %s (previous layout; expected root:%s — run %ssudo auth rebuild%s to migrate)\n' \
      "$c_yellow" "$c_reset" "$owner" "$app_user" "$c_bold" "$c_reset"
    warn=1
  else
    printf '  %s✗%s owned by %s (expected root:%s — auth-server runs as %s and reads it through the group)\n' \
      "$c_red" "$c_reset" "$owner" "$app_user" "$app_user"
    printf '       fix: %ssudo chown root:%s %s && sudo chmod 0640 %s%s\n' "$c_dim" "$app_user" "$ENV_LOCAL" "$ENV_LOCAL" "$c_reset"
    fail=1
  fi
  if [[ "$mode" == "640" || "$mode" == "600" || "$mode" == "400" ]]; then
    printf '  %s✓%s mode %s\n' "$c_green" "$c_reset" "$mode"
  else
    printf '  %s!%s mode %s (expected 640 — secrets in this file)\n' "$c_yellow" "$c_reset" "$mode"
    warn=1
  fi

  if [[ "$EUID" -eq 0 ]]; then
    if runuser -u "$app_user" -- test -r "$ENV_LOCAL" 2>/dev/null; then
      printf '  %s✓%s readable by %s\n' "$c_green" "$c_reset" "$app_user"
    else
      printf '  %s✗%s %s cannot read %s — auth-server will fail on startup\n' \
        "$c_red" "$c_reset" "$app_user" "$ENV_LOCAL"
      fail=1
    fi
  else
    printf '  %s!%s skipping user-read check (re-run as root for full validation)\n' \
      "$c_yellow" "$c_reset"
    warn=1
  fi

  local keys=0 bad=0
  local -a bad_lines=()
  local lineno=0
  while IFS= read -r line || [[ -n "$line" ]]; do
    lineno=$((lineno + 1))
    local trimmed="${line#"${line%%[![:space:]]*}"}"
    trimmed="${trimmed%"${trimmed##*[![:space:]]}"}"
    [[ -z "$trimmed" ]] && continue
    [[ "$trimmed" =~ ^# ]] && continue
    if [[ "$trimmed" =~ ^[A-Za-z_][A-Za-z0-9_]*= ]]; then
      keys=$((keys + 1))
    else
      bad=$((bad + 1))
      [[ "${#bad_lines[@]}" -lt 5 ]] && bad_lines+=("$lineno: $trimmed")
    fi
  done <"$ENV_LOCAL"
  printf '  %s✓%s %d keys parsed\n' "$c_green" "$c_reset" "$keys"
  if [[ "$bad" -gt 0 ]]; then
    printf '  %s!%s %d line(s) without KEY= prefix (auth-server will skip them):\n' \
      "$c_yellow" "$c_reset" "$bad"
    for b in "${bad_lines[@]}"; do printf '       line %s\n' "$b"; done
    warn=1
  fi

  # The whole install layout, when the library is present and root's own
  # (a tree from the previous layout is not sourced; the migration in
  # docs/DEPLOY.md installs it root-owned).
  local lib="$APP_DIR/scripts/lib/layout.sh" libstat
  libstat="$(stat -c '%U %a' "$lib" 2>/dev/null || echo "")"
  if [[ -f "$lib" && ! -L "$lib" && "${libstat% *}" == "root" && "$(( 8#${libstat#* } & 8#022 ))" -eq 0 ]]; then
    local data_dir="${AUTH_DATA_DIR:-$APP_DIR/data}"
    if APP_DIR="$APP_DIR" APP_USER="$app_user" DATA_DIR="$data_dir" ENV_FILE="$ENV_LOCAL" \
         bash -c '. "$1" && layout_check' _ "$lib" 2>&1 | sed 's/^/       /'; then
      printf '  %s✓%s install layout: root owns the tree, %s owns %s\n' "$c_green" "$c_reset" "$app_user" "$data_dir"
    else
      printf '  %s✗%s install layout differs from docs/DEPLOY.md (see above); run the migration in docs/DEPLOY.md\n' "$c_red" "$c_reset"
      fail=1
    fi
  else
    printf '  %s!%s install layout not checked: %s is missing or not root-owned (previous layout; see the migration in docs/DEPLOY.md)\n' "$c_yellow" "$c_reset" "$lib"
    warn=1
  fi

  echo
  if [[ "$fail" -ne 0 ]]; then
    printf '%s✗ %s has problems auth-server will trip on.%s\n' "$c_red" "$ENV_LOCAL" "$c_reset"
    return 1
  fi
  if [[ "$warn" -ne 0 ]]; then
    printf '%s! %s looks usable but has warnings.%s\n' "$c_yellow" "$ENV_LOCAL" "$c_reset"
    return 0
  fi
  printf '%s✓ %s is good — auth-server should start cleanly.%s\n' "$c_green" "$ENV_LOCAL" "$c_reset"
}

cmd="${1:-}"
shift || true

if [[ "$cmd" != "doctor" ]]; then
  load_env_helpers
fi

case "$cmd" in
  domain|user|audit|app|mfa|keygen|pubkey)
    # domain: the magic-link allowlist. user: password accounts and the
    # legacy audit. audit: security events. app: confidential clients (the
    # secret is printed once, only its hash is kept). mfa: AUTH_MFA_KEY
    # generation and the two-factor policy. keygen: a fresh signing keypair
    # (touches nothing). pubkey: the public half of the current signing key.
    # All run as the service user against the database the running server
    # uses; see run_admin.
    run_admin "$cmd" "$@"
    ;;
  update)
    exec sudo bash "$APP_DIR/scripts/update.sh" "$@"
    ;;
  rebuild)
    # Rebuild and restart whatever is checked out, without git fetch.
    exec sudo env AUTH_UPDATE_NO_PULL=1 AUTH_UPDATE_YES=1 bash "$APP_DIR/scripts/update.sh"
    ;;
  start)
    exec sudo systemctl start auth.target
    ;;
  stop)
    exec sudo systemctl stop auth-server.service
    ;;
  restart)
    exec sudo systemctl restart auth-server.service
    ;;
  status)
    exec sudo systemctl status auth-server.service
    ;;
  logs)
    if [[ "$#" -eq 0 ]]; then
      exec sudo journalctl -f -u auth-server
    else
      exec sudo journalctl "$@" -u auth-server
    fi
    ;;
  backup)
    [[ $EUID -eq 0 ]] || exec sudo -- "$0" backup "$@"
    load_env_file "$ENV_LOCAL"
    data_dir="${AUTH_DATA_DIR:-$APP_DIR/data}"
    dest="${1:-$data_dir/backups}"
    install -d -m 0700 -o "$APP_USER" -g "$APP_USER" "$dest"
    stamp="$(date +%F-%H%M%S)"
    # SQLite's online backup via `.backup` produces a consistent snapshot
    # while the server is running (sqlite3 is installed by bootstrap). It
    # runs as the service user so no root-owned -wal/-shm file can appear
    # beside the database.
    out="$dest/auth-$stamp.db"
    runuser -u "$APP_USER" -- bash -c "umask 077 && sqlite3 '$data_dir/state.db' \".backup '$out'\""
    echo "✓ backup written to $out"
    echo "  restore with: sudo auth stop && sudo rm -f $data_dir/state.db-wal $data_dir/state.db-shm && sudo cp $out $data_dir/state.db && sudo chown $APP_USER:$APP_USER $data_dir/state.db && sudo auth start"
    ;;
  env)
    env_cmd "$@"
    ;;
  doctor)
    # .env.local is root:auth 0640, so the check re-execs through sudo. The
    # script it execs is the root-owned copy, never the service-writable tree,
    # including --help. The copy is installed next to this CLI.
    self="${BASH_SOURCE[0]}"
    case "$self" in
      /*) ;;
      *) self="$PWD/$self" ;;
    esac
    prefix="$(dirname -- "$(dirname -- "$self")")"
    repo_doctor="$APP_DIR/scripts/doctor.sh"
    if [[ ! -f "$repo_doctor" ]]; then
      repo_doctor="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/scripts/doctor.sh"
    fi
    doctor_sh=""
    for candidate in "$prefix/lib/auth/doctor.sh" /usr/local/lib/auth/doctor.sh "$repo_doctor"; do
      if script_root_owned "$candidate" && script_root_owned "$(dirname -- "$candidate")/lib/envfile.sh"; then
        doctor_sh="$candidate"
        break
      fi
    done
    if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
      if [[ -n "$doctor_sh" ]]; then
        exec bash "$doctor_sh" --help
      fi
      if [[ $EUID -ne 0 && -f "$repo_doctor" && ! -L "$repo_doctor" ]]; then
        exec bash "$repo_doctor" --help
      fi
      cat <<'EOF'
auth doctor — read-only box diagnosis (safe repairs only with --repair)

  auth doctor            inspect only; change nothing
  auth doctor --check    same as the default
  auth doctor --json     JSON report on stdout
  sudo auth doctor --repair
                         fix env mode and start an inactive unit

Help from the CLI; the checkout script was not executed.
EOF
      exit 0
    fi
    if [[ -z "$doctor_sh" ]]; then
      echo "refusing to run doctor as root from a service-writable script; run auth update to install the root-owned copy next to this command" >&2
      exit 1
    fi
    if [[ $EUID -ne 0 ]]; then
      exec sudo "$doctor_sh" "$@"
    fi
    exec bash "$doctor_sh" "$@"
    ;;
  help|-h|--help|"")
    cat <<'EOF'
auth — Elcano auth-server operator CLI

DOMAIN ALLOWLIST
  auth domain add <example.com>     allow this email domain to request links
  auth domain del <example.com>     stop allowing
  auth domain list                  show current allowlist
                                    (empty allowlist = open enrollment)

USERS
  auth user create <email>          create password account (secure prompt)
  auth user set-password <email>    replace password and revoke sessions
  auth user disable <email>         disable account and revoke sessions
  auth user enable <email>          re-enable account
  auth user admin <email> on|off    grant or remove access to the web admin console
  auth user access <email> <app> on|off  let (or stop letting) an account sign in to one application
  auth user team <email> <team|->   set or clear the account's team tag
  auth user show <email>            show account state and active sessions
  auth user revoke-sessions <email> revoke all sessions for one account
  auth user mfa-required <email> on|off  require two-factor sign-in for one account
  auth user mfa-reset <email> --reason "<text>"  remove a lost authenticator (they enroll again)
  auth user list                    password accounts + magic-link audit
  auth user del <email>             remove a user from magic-link audit

AUDIT
  auth audit list [email] [limit]   newest security events (password mode)

APPLICATIONS
  auth app create <id> <callback> [logout]  register a confidential client
  auth app list | show <id>                 inspect registered clients
  auth app rotate-secret <id>               replace + print the secret once
  auth app disable|enable <id>              control new login handoffs

CRYPTO
  auth keygen                       print a fresh Ed25519 signing keypair
  auth pubkey                       print AUTH_SIGNING_PUBKEY for the current
                                    signing key (to hand to verifying services)
  auth mfa keygen                   print a fresh AUTH_MFA_KEY for 2FA secrets
  auth mfa policy [mode]            show or set the two-factor policy
                                    (optional | admins | everyone)

UPDATES
  auth update                       git pull + rebuild + restart
                                    (set AUTH_UPDATE_YES=1 to skip the prompt)
  auth rebuild                      rebuild + restart current checkout
                                    (skip fetch — useful after manual rollback)

SERVICE CONTROL
  auth start | stop | restart       control the systemd unit
  auth status                       show service status
  auth logs [journalctl-args...]    tail auth-server logs
                                    (no args = -f; passes -e, -n N, etc. through)

CONFIG
  auth env [show]                   print .env.local (secrets redacted)
  auth env edit                     open .env.local in nano, vim, or helix
  auth env check                    verify .env.local exists + parses cleanly

DIAGNOSIS
  auth doctor [--check] [--json]    read-only box check (unit, env, /healthz,
                                    TLS, SQLite, disk, updates, git)
  sudo auth doctor --repair         fix .env.local mode/owner, data-dir mode,
                                    and start an inactive auth-server

DATA
  auth backup [dest]                online-backup state.db (default:
                                    /opt/auth/data/backups)
EOF
    ;;
  *)
    echo "unknown command: $cmd" >&2
    exec "$0" --help
    ;;
esac
