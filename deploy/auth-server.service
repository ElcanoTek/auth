[Unit]
# auth-server — the magic-link login service. Loopback-only; Caddy
# terminates TLS in front. One SQLite file under /opt/auth/data is the
# only state.
Description=Elcano auth-server (magic-link login)
After=network-online.target
Wants=network-online.target
PartOf=auth.target

[Service]
Type=simple
User=auth
Group=auth
WorkingDirectory=/opt/auth
ExecStart=/opt/auth/bin/auth-server -env /opt/auth/.env.local

Restart=on-failure
RestartSec=3
TimeoutStopSec=20

# Conservative limits — this service does almost nothing.
MemoryMax=256M
CPUQuota=50%

# Writable paths:
#   /opt/auth/data — the SQLite file + WAL/SHM. PrivateTmp gives us
#                    /tmp; we don't need anything else writable.
ReadWritePaths=/opt/auth/data

# Hardening. auth-server has a tiny attack surface (HTTP + SQLite +
# outbound HTTPS to sendgrid), so we can apply the heavy systemd
# sandboxing profile without breaking anything.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
# AF_UNIX so net/http's stdlib helpers work; AF_INET/INET6 for the
# HTTP listener + outbound HTTPS to SendGrid.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
# No SystemCallFilter — the cost/benefit is poor for a pure Go binary
# that touches only the net + crypto syscalls. The bound profile above
# already constrains what it can do.
UMask=0027
KeyringMode=private

StandardOutput=journal
StandardError=journal
SyslogIdentifier=auth-server

[Install]
WantedBy=multi-user.target
