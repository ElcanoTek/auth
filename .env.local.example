# auth-server .env.local — copy to .env.local and edit.
# scripts/bootstrap.sh generates a populated .env.local for you;
# this file is the reference catalog.

# ── Transport ────────────────────────────────────────────────────
# Loopback only. Caddy terminates TLS in front and proxies here.
AUTH_ADDR="127.0.0.1:9000"

# Public hostname. The magic-link URL is built from this — must be
# the externally-visible name browsers reach (e.g. auth.elcanotek.com).
AUTH_HOSTNAME="auth.example.com"

# State directory. SQLite file lives at $AUTH_DATA_DIR/state.db.
AUTH_DATA_DIR="/opt/auth/data"

# Authentication mode. Existing deployments default to magic. New client
# deployments set password; this keeps the legacy Elcano flow unchanged.
# AUTH_LOGIN_MODE="magic"

# Public origin used as the identity issuer and in discovery metadata. Empty
# derives https://AUTH_HOSTNAME (or http:// only when Secure cookies are
# explicitly disabled for local development).
# AUTH_ISSUER_URL="https://auth.example.com"

# ── Crypto ───────────────────────────────────────────────────────
# Ed25519 signing keypair. AUTH_SIGNING_KEY is the base64 private seed that
# signs magic-link tokens and session cookies — it lives ONLY on the auth
# host. Generate a keypair with `auth-admin keygen`; bootstrap.sh writes it
# for you. Rotating it logs everyone out and requires re-distributing the
# new public key to every verifying service.
AUTH_SIGNING_KEY=""
# The matching public key. auth derives this from AUTH_SIGNING_KEY and does
# not read this var — but copy this value into each verifying service
# (home/chat) as their AUTH_SIGNING_PUBKEY. Safe to share: it can verify a
# token but never mint one.
# AUTH_SIGNING_PUBKEY=""
# During a signing-key rotation, publish old public keys alongside the new key
# until every short-lived assertion they verify has expired. Comma-separated.
# AUTH_SIGNING_PREVIOUS_PUBKEYS=""

# Session and magic-link TTLs. Defaults: 30 days, 15 minutes.
# AUTH_SESSION_TTL_DAYS="30"
# AUTH_MAGIC_TTL_MINUTES="15"

# Abuse limits on POST /magic (the email-sending endpoint). Each counts
# magic links issued over a rolling window and, once the cap is hit, returns
# the same "check your inbox" page WITHOUT sending another email (no leak).
# Per-email window is 15 min, global window is 60 min. Set 0 to disable.
# AUTH_MAGIC_RATE_PER_EMAIL="10"   # max links per email / 15 min
# AUTH_MAGIC_GLOBAL_LIMIT="500"    # max links total / 60 min

# ── Cookie ───────────────────────────────────────────────────────
# Cookie name. Deliberately distinct from chat's existing
# 'elcano_session' cookie — chat stays on its own auth for now and
# we don't want browsers sending both cookies and chat picking the
# wrong one. See docs/INTEGRATION.md for the three-tier design
# (unified daily tools / chat / moc-admin) and the future migration
# path when chat eventually joins the unified tier.
AUTH_COOKIE_NAME="elcano_auth"

# Domain to set on the cookie — the SHARED parent of every service
# that should see it. For auth.elcanotek.com → set "elcanotek.com" so
# the cookie also rides to chat.elcanotek.com, home.elcanotek.com, etc.
# Empty = host-only cookie (single-host local dev).
AUTH_COOKIE_DOMAIN="example.com"

# Set "false" only for plain-HTTP local dev. Production = true.
# AUTH_COOKIE_SECURE="true"

# Password-mode sessions are host-only and never use AUTH_COOKIE_DOMAIN.
# Production cookie names must retain the __Host- prefix. Plain-HTTP local
# development must set this to "auth_session" when AUTH_COOKIE_SECURE=false,
# because clients correctly reject an insecure __Host- cookie. Defaults are a
# 30-day absolute lifetime (720 hours), 7-day idle lifetime (10080 minutes),
# and persistent failure limits over a 15-minute window. This is the only
# session users re-enter a password for; application sessions renew silently
# against it, so keep it long and let the apps stay short (one day).
# AUTH_PASSWORD_COOKIE_NAME="__Host-auth_session"
# AUTH_PASSWORD_ABSOLUTE_HOURS="720"
# AUTH_PASSWORD_IDLE_MINUTES="10080"
# AUTH_PASSWORD_RATE_PER_EMAIL="10"
# AUTH_PASSWORD_RATE_PER_IP="50"
# Client branding: a checkout of the client's bundle (the repository Fleet
# consumes). Only its branding: block is read (wordmark, mark, colours, login
# copy); prose keeps AUTH_BRAND_NAME. See DEPLOY.md "Branding from the client
# bundle". Unset = default look.
# Keep it OUTSIDE /opt/auth: the source sync runs rsync --delete over that tree.
# AUTH_CLIENT_CONFIG_DIR="/opt/auth-client"
# Password policy: at least 12 characters, no character-class rules, and a
# blocklist of common passwords plus words a password must not be built from
# (the user's email, the brand, this hostname). Add the client's own names
# here, comma-separated, so "Omnicom2026!" is refused too.
# AUTH_PASSWORD_BLOCKED_TERMS="Omnicom,OMC"
# One-use application authorization codes live for 60 seconds. Signed identity
# assertions live for five minutes; both maxima are intentionally bounded.
# AUTH_CODE_TTL_SECONDS="60"
# AUTH_ASSERTION_TTL_MINUTES="5"
# Password-mode audit_events retention in days (0 = keep forever).
# AUTH_AUDIT_RETENTION_DAYS="90"

# ── Tenancy / allowlist ──────────────────────────────────────────
# Comma-separated email domains permitted to request a magic link.
# Empty = open enrollment (anyone with any email can request — don't
# do this in prod). Runtime additions via `auth domain add` are kept
# across restarts; this var is only a one-shot bootstrap seed.
AUTH_ALLOWED_DOMAINS="elcanotek.com"

# ── Email delivery ───────────────────────────────────────────────
# Driver: stdout | sendgrid | smtp.
#   stdout   — print to journal (DEV ONLY; anyone with journalctl
#              access can read other users' login links).
#   sendgrid — POST to api.sendgrid.com with SENDGRID_API_KEY.
#              Re-uses the same key chat-server uses, so one
#              SendGrid account covers the whole stack.
#   smtp     — STARTTLS to AUTH_SMTP_HOST.
AUTH_EMAIL_DRIVER="sendgrid"

# RFC-5322 "Name <addr@domain>" or just "addr@domain". Must be a
# verified sender on your SendGrid account (or whatever provider).
AUTH_EMAIL_FROM="Sign in <login@elcanotek.com>"

# SendGrid API key. Same env var name chat-server uses.
SENDGRID_API_KEY=""

# SMTP (only if AUTH_EMAIL_DRIVER=smtp)
# AUTH_SMTP_HOST="smtp.example.com"
# AUTH_SMTP_PORT="587"
# AUTH_SMTP_USER=""
# AUTH_SMTP_PASS=""

# ── UX ───────────────────────────────────────────────────────────
# Shown in the subject line + on the login page. Keep generic so the
# email body works unchanged for every client.
AUTH_BRAND_NAME="Elcano"

# Where /callback sends users when no ?return_to= was provided. Empty
# defaults to https://home.<AUTH_COOKIE_DOMAIN> (the stack's home service)
# when a cookie domain is set, else /me (a JSON debug view). Set explicitly
# to land users on a different service.
AUTH_DEFAULT_RETURN_TO=""

# Comma-separated host allowlist for ?return_to=. Entries beginning
# with "." match the bare domain and all subdomains (e.g.
# ".elcanotek.com" matches elcanotek.com + chat.elcanotek.com).
# Empty = derived from AUTH_COOKIE_DOMAIN ("." + cookie_domain).
# AUTH_RETURN_TO_HOSTS=".elcanotek.com,.clientco.com"
